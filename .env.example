TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا
TIMEFRAMES=5m,15m,1h
SCAN_SECONDS=60
MONITOR_SECONDS=20
RR=2.0
PIVOT_LEN=5
DIVISOR=3.6
SL_ATR_MULT=1.15
# Thresholds selected for forward/out-of-sample validation; not a profitability guarantee.
MIN_SCORE_5M=60
MIN_AI_PROB_5M=0.30
MIN_SCORE_15M=65
MIN_AI_PROB_15M=0.30
MIN_SCORE_1H=60
MIN_AI_PROB_1H=0.35
MODEL_HISTORY_BARS=10000
MODEL_REFRESH_HOURS=6
DB_PATH=data/gold_bot.sqlite3

# Optional QuantConnect Cloud / LEAN backtesting integration.
# Leave blank to keep the existing backtest flow unchanged.
# Create an API token at https://www.quantconnect.com/settings/
# and use a QuantConnect project that contains the corresponding LEAN algorithm.
QC_USER_ID=
QC_API_TOKEN=
QC_PROJECT_ID=

# GitHub Actions bridge for real-history LEAN backtests requested from Telegram.
# Create a fine-grained token for this repository with Actions: Read and write.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPOSITORY=mosnad1111-cyber/universal-ml-signal-bot-chatgpt
# Render sets RENDER_EXTERNAL_URL automatically; override only when necessary.
LEAN_CALLBACK_BASE_URL=
